###############################################################################
# GeneralDevDocker - environment template
#
# This is the VERSIONED template. The real, per-machine file is `.env`, which is
# git-ignored (see .gitignore) and never committed. Set it up once:
#
#     cp .env.example .env
#     # then edit .env and fill in the REQUIRED values for this machine
#
# Docker Compose auto-loads `.env` from this directory. Every variable below is
# read by compose.yaml.
#
# Convention used here:
#   - REQUIRED vars are uncommented with a placeholder you MUST replace.
#   - OPTIONAL vars are commented out and show their built-in default; uncomment
#     only to override.
# Validate the result any time with:  docker compose config
###############################################################################


#==============================================================================
# REQUIRED - git identity (applied to `git config --global` inside the container
#            by entrypoint.sh, on every container start; no rebuild needed to change)
#==============================================================================

DEV_NAME=Your Name
DEV_EMAIL=you@example.com


#==============================================================================
# REQUIRED - host->container file bridge (fast_share)
#
# An ABSOLUTE host directory bind-mounted to ~/fast_share inside the container -
# the ONLY host directory the container sees. Use it to hand-carry files in and
# out (e.g. the public key printed by `generate-ssh-key`, or a host key for
# `import-ssh-keys-from-fastshare` - see README "SSH keys").
#
# The directory must EXIST and be owned by USER_ID:GROUP_ID (default 1000:1000),
# or the bind-mount creates a root-owned, unwritable one. On a default UID-1000
# desktop, creating it as yourself is enough:
#     mkdir -p ~/fast_share_gdd
#==============================================================================

FASTSHARE_PATH=/absolute/path/to/your/fast_share


#==============================================================================
# OPTIONAL - X11 display for GUI apps (Typora, ...)
#
# Defaults to :0, which is correct for a standard single-display Linux desktop.
# Override only if `echo $DISPLAY` on your host prints something else.
#==============================================================================

# DISPLAY=:0


#==============================================================================
# OPTIONAL - UID/GID of the container's `devuser` (default 1000)
#
# Linux maps file ownership by numeric id, so files the container writes into
# fast_share are owned on the host by whoever has this UID. Default 1000 = the
# typical first non-root desktop user. Check yours with `id -u` / `id -g`.
#==============================================================================

# USER_ID=1000
# GROUP_ID=1000


#==============================================================================
# OPTIONAL - naming overrides (defaults shown). CONTAINER_NAME is also used as
# the container's hostname.
#==============================================================================

# IMAGE_NAME=general-dev-env
# CONTAINER_NAME=general-dev
