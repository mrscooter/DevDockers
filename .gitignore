# Per-machine env files (never versioned). Templates (.env.example) ARE tracked.
.env
.env-backup*

# Session handoff snapshots - local working memory, not versioned.
context_restore*.md

# IDE
.idea/

# Claude Code: ignore the per-machine + ephemeral layer, but allow the shareable
# layer (.claude/settings.json, skills/, commands/, agents/, ...) to be committed
# for cross-machine use.
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock
