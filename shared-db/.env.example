###############################################################################
# shared-db - environment template
#
# Standalone, shared Postgres 16 for the FullStackWebDevDocker fleet. Started
# ONCE; every worktree dev-docker connects to it at localhost:${PG_HOST_PORT}.
#
#     cp .env.example .env      # then adjust if needed
#
# IMPORTANT: POSTGRES_USER / POSTGRES_PASSWORD / PG_HOST_PORT here must match the
# same vars in each FullStackWebDevDocker/.env, or the dev-dockers can't connect.
#
# These values are read at FIRST init only (when the data volume is empty). The
# postgres image runs initdb once, creating the role + POSTGRES_DB. After that,
# changing them has no effect until you wipe the volume (`docker compose down -v`).
# Per-worktree databases are created separately with `createdb` (see README).
###############################################################################

POSTGRES_USER=admin
POSTGRES_PASSWORD=devPass77
POSTGRES_DB=app_dev

# Host-facing port (container side stays 5432). Default 5433 dodges a native
# host Postgres on 5432. If 5433 is also taken, `docker compose up` fails with
# "port is already allocated" - bump this and update every dev-docker's .env.
# Check first with:  ss -ltn '( sport = :5433 )'
PG_HOST_PORT=5433

# Optional container-name override (only needed to run a second shared DB).
# DB_CONTAINER_NAME=shared-dev-db
