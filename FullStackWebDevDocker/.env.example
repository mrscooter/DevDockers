###############################################################################
# FullStackWebDevDocker - environment template
#
# This is the VERSIONED template. The real, per-machine file is `.env`, which is
# git-ignored (see .gitignore) and never committed. Set it up once:
#
#     cp .env.example .env
#     # then edit .env and fill in the REQUIRED values for this machine
#
# Docker Compose auto-loads `.env` from this directory. Every variable below is
# read by compose.yaml (or compose.external-mount.yaml), except SSH_KEY_DIR (read by
# zsh-into-docker-container.sh). For the prose walkthrough
# see README.md - this file is the exhaustive variable reference.
#
# Convention used here:
#   - REQUIRED vars are uncommented with a placeholder you MUST replace.
#   - OPTIONAL vars are commented out and show their built-in default; uncomment
#     only to override.
# Validate the result any time with:  docker compose config
###############################################################################


#==============================================================================
# REQUIRED - git identity (applied to `git config --global` inside the container
#            by entrypoint.sh, on every container start; no rebuild needed to change)
#==============================================================================

DEV_NAME=Your Name
DEV_EMAIL=you@example.com


#==============================================================================
# REQUIRED - shared Postgres connection
#
# Postgres is NOT in this compose file. It runs as a separate, shared standalone
# project (../shared-db), started once and reused by every worktree dev-docker.
# These feed the libpq PGHOST/PGPORT/PGUSER/PGPASSWORD connection vars (and the
# BASE_DEV_DB_URL template) inside the container. They MUST match the shared-db
# project's own .env (same user/password, and PG_HOST_PORT = its published port).
#
# The DATABASE is intentionally NOT ambient (no PGDATABASE is exported), so a
# worktree never hits a shared default by accident - pick it explicitly. Each
# worktree's app config / .env names its own DB; create it once against shared-db:
#     createdb -h localhost -p 5433 -U admin <your_db>
#
# Check the connection inside the container (psql now needs an explicit -d):
#     echo $BASE_DEV_DB_URL     # postgresql://admin:devPass77@localhost:5433/<default_db>
#     echo $PGHOST:$PGPORT      # localhost:5433
#     psql -d <your_db>         # bare `psql` has no default DB now
#==============================================================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=devPass77
POSTGRES_DB=devdocker_default_db   # default DB in the BASE_DEV_DB_URL template; match shared-db's POSTGRES_DB
PG_HOST_PORT=5433            # must equal shared-db's published host port


#==============================================================================
# REQUIRED - host->container file bridge (fast_share)
#
# Host directory bind-mounted to ~/fast_share inside the container, for
# hand-carrying files in and out.
#
# Must start with /, ~/, ./ or ../ (a bare name like `fast_share` is read as a
# named Docker volume, not a host dir). Relative paths resolve against this
# directory (where compose.yaml lives), not your shell's cwd.
#
# The directory must EXIST and be owned by USER_ID:GROUP_ID (default 1000:1000) so
# the container user can read/write it. On a default UID-1000 desktop, creating it
# as yourself is enough (no chown needed):
#     mkdir -p ~/fast_share_fswdd
# If your host user is NOT 1000 (so you set USER_ID/GROUP_ID below), match them:
#     sudo chown ${USER_ID:-1000}:${GROUP_ID:-1000} ~/fast_share_fswdd
#==============================================================================

FASTSHARE_PATH=/path/to/your/fast_share


#==============================================================================
# OPTIONAL - SSH keys for the container (see README "SSH keys")
#
# HOST directory with the container's keys (default ~/.ssh/<CONTAINER_NAME>, so
# ~/.ssh/fullstack-web-dev). zsh-into-docker-container.sh loads every private key
# in it that has its .pub next to it into a host-side ssh-agent of this container
# whose socket it uses; the key files themselves never enter the container. Keep
# the dir dedicated: every key in it is usable from the container. No such dir =
# no SSH agent for the container. Worktree copies with their own CONTAINER_NAME
# can point here to share the same keys.
#==============================================================================

# SSH_KEY_DIR=~/.ssh/fullstack-web-dev


#==============================================================================
# OPTIONAL - Claude integration (skills/instructions bootstrap)
#
# LOGIN is NOT configured here: nothing from the host's ~/.claude is shared. Log
# into Claude once inside the container; it persists in the home volume.
#
# BOOTSTRAP runs in entrypoint.sh on every start (idempotent - a no-op once done,
# results persist in the home volume): clones the PUBLIC utils repo, then symlinks
# its GLOBAL-GENERAL-CLAUDE.md + skills into ~/.claude and writes a Mercury-free
# ~/.claude/CLAUDE.md. The instruction/skill files are symlinks, so editing the repo
# is reflected live; FORCE is only needed to git-pull new commits, reset the
# generated CLAUDE.md, or re-point the symlinks.
#==============================================================================

# CLAUDE_BOOTSTRAP=true
# CLAUDE_BOOTSTRAP_FORCE=false
# CLAUDE_UTILS_REPO=https://github.com/mrscooter/nicnajder-general-utils.git
# CLAUDE_UTILS_DIR=/home/devuser/Tools/nicnajder-general-utils


#==============================================================================
# OPTIONAL - shell prompt prefix
#
# Text shown at the start of the zsh prompt inside the container, so its shells
# are easy to tell apart from host ones. Plain text or a nerd-font glyph (drawn by
# the HOST terminal's font). zsh prompt escapes work, e.g. %F{cyan}(fswdd)%f for
# color. Unset / empty = no prefix. Apply a change with ./up.sh (recreates the
# container, no rebuild needed).
#==============================================================================

# PROMPT_PREFIX=(fswdd)


#==============================================================================
# OPTIONAL - X11 display for the WebStorm GUI
#
# Defaults to :0, which is correct for a standard single-display Linux desktop.
# Override only if `echo $DISPLAY` on your host prints something else.
# (`./up.sh` grants the container X access on each start - see README.)
#==============================================================================

# DISPLAY=:0


#==============================================================================
# OPTIONAL - provide your project via an external host bind-mount (Mode B)
#
# DEFAULT (both lines commented out) = Mode A: no host bind-mount. You `git clone`
# your project INSIDE the container at ~/code/<project>; it lives in the named
# volume (invisible to host, survives restarts, wiped only by `down -v`).
#
# Mode B (opt-in) bind-mounts a host checkout into the container at
# ~/code/project-external (the `-external` suffix keeps it from ever colliding
# with a Mode A clone). Uncomment BOTH lines to enable:
#
#   - COMPOSE_FILE tells compose to load the overlay IN ADDITION to compose.yaml.
#     Compose merges the two; the overlay only appends the bind-mount volume.
#   - HOST_CODE_PATH is the ABSOLUTE path to your checkout on the host.
#
# See README "Providing your project (Mode A vs Mode B)" for details.
#==============================================================================

# COMPOSE_FILE=compose.yaml:compose.external-mount.yaml
# HOST_CODE_PATH=/absolute/path/to/your/project


#==============================================================================
# OPTIONAL - UID/GID of the container's `devuser` (default 1000)
#
# Only matters for the Mode B bind-mount: Linux maps file ownership by numeric
# id, so files the container writes into the host checkout are owned on the host
# by whoever has this UID. Default 1000 = the typical first non-root Linux
# desktop user, so files come out owned by YOU with no chown needed.
#
# Check your host ids:   id -u   (UID)    id -g   (GID)
# If your host user is NOT 1000, set these to your actual ids; otherwise leave
# the defaults. (The Dockerfile deletes the ubuntu:24.04 base image's built-in
# `ubuntu` user so UID 1000 is free - that's why 1000 works as the default here,
# unlike CLionDevDocker which uses 1111.)
#==============================================================================

# USER_ID=1000
# GROUP_ID=1000


#==============================================================================
# OPTIONAL - naming overrides (defaults shown). Change these only when running
# more than one worktree dev-docker side by side (see README "Running multiple
# worktrees"), so the image/container don't clash. CONTAINER_NAME also names the
# container's ssh-agent socket dir and default SSH_KEY_DIR.
#==============================================================================

# IMAGE_NAME=fullstack-web-dev-env
# CONTAINER_NAME=fullstack-web-dev
